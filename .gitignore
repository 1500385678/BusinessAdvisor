# ============================================================
# BusinessAdvisor · .gitignore
# 0826 Phase 0 工程可启动前置件
# 覆盖:Python (FastAPI 后端) + Node (React 前端) + 通用
# ============================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
venv/
env/
ENV/
.venv/
.env
.env.local
.env.*.local

# 测试 / 覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints

# ----- Node / React 前端 -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 构建产物
.next/
.nuxt/
out/
build/
dist/
.vite/

# 缓存
.eslintcache
.parcel-cache

# 依赖锁目录(可选:通常 package-lock.json 要入库,这里只忽略罕见目录)
jspm_packages/

# ----- TypeScript -----
*.tsbuildinfo

# ----- 数据库 / 数据文件 -----
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3

# 日志
*.log
logs/
.Log/*.tmp

# ----- 通用 IDE / 编辑器 -----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride
Icon?
ehthumbs.db
Thumbs.db
Desktop.ini

# ----- macOS -----
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.DocumentRevisions-V100
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ----- 临时 / 草稿 -----
tmp/
temp/
*.tmp
*.bak
*.swp
*.orig
.env.bak

# ----- 密钥 / 凭证(防御性) -----
*.pem
*.key
*.crt
secrets/
credentials/
